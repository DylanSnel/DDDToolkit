<Project>
  <!--
    Two sets of versions for the same packages.

    Floor: what a published package declares as its dependency. NuGet writes Version="X" into the
    nuspec as ">= X", so this is the oldest version a consumer is allowed to have, not the version
    they get. Keeping it at the oldest release that works means installing DDDToolkit never drags a
    consumer's Entity Framework, HotChocolate or FluentValidation forward to whatever patch this
    repository happened to be on. Raise a floor only when the code needs something newer, and say why
    next to it.

    Latest: what the tests, examples and benchmarks build and run against, so day-to-day development
    and the main test run use current releases. Transitive pinning is on in this mode, so a test project
    also gets the latest version of a dependency that only arrives through a Source project.

    Projects under Source/ use Floor, everything else Latest. Build with -p:DDDDependencyVersions=Floor
    to run the whole solution, tests included, against the floors; the Build and Test workflow does
    that in a job of its own, which is what keeps the floors honest.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <_DDDShippedProject>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('Source'))</_DDDShippedProject>
    <DDDDependencyVersions Condition="'$(DDDDependencyVersions)' == '' and '$(_DDDShippedProject)' == 'True'">Floor</DDDDependencyVersions>
    <DDDDependencyVersions Condition="'$(DDDDependencyVersions)' == ''">Latest</DDDDependencyVersions>
    <CentralPackageTransitivePinningEnabled Condition="'$(DDDDependencyVersions)' == 'Latest'">true</CentralPackageTransitivePinningEnabled>
    <CentralPackageTransitivePinningEnabled Condition="'$(DDDDependencyVersions)' != 'Latest'">false</CentralPackageTransitivePinningEnabled>
    <!--
      In a floor run the tests and examples restore deliberately old test tooling (Sqlite, EF Design),
      whose advisories say nothing about what ships. The Source projects keep auditing, so an advisory
      against one of the floors themselves still shows.
    -->
    <NuGetAudit Condition="'$(DDDDependencyVersions)' == 'Floor' and '$(_DDDShippedProject)' != 'True'">false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup Label="Floors" Condition="'$(DDDDependencyVersions)' == 'Floor'">
    <!-- The release the Wolverine integration was written and tested against; nothing older is known to work. -->
    <WolverineVersion>6.39.1</WolverineVersion>
    <MassTransitVersion>8.5.10</MassTransitVersion>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
    <EntityFrameworkCoreVersion>10.0.0</EntityFrameworkCoreVersion>
    <AspNetCoreVersion>10.0.0</AspNetCoreVersion>
    <!-- What JwtBearer 10.0.0 itself depends on, so the two Supabase auth packages agree at the floor. -->
    <IdentityModelVersion>8.0.1</IdentityModelVersion>
    <!-- The first release of the isolated worker's 2.x line, which has the middleware API used here. -->
    <AzureFunctionsWorkerVersion>2.0.0</AzureFunctionsWorkerVersion>
    <NpgsqlVersion>10.0.0</NpgsqlVersion>
    <HotChocolateVersion>16.0.0</HotChocolateVersion>
    <FluentValidationVersion>12.0.0</FluentValidationVersion>
    <!-- 13.0.1 is the first release without the stack-overflow advisory GHSA-5crp-9r3c-p9vr. -->
    <NewtonsoftJsonVersion>13.0.1</NewtonsoftJsonVersion>
    <!-- 3.0.0 was never published. -->
    <MediatorVersion>3.0.1</MediatorVersion>
    <!-- The generators are compiled against the oldest Roslyn that understands C# 13 partial properties. -->
    <RoslynVersion>4.12.0</RoslynVersion>
  </PropertyGroup>

  <PropertyGroup Label="Latest" Condition="'$(DDDDependencyVersions)' == 'Latest'">
    <WolverineVersion>6.39.1</WolverineVersion>
    <MassTransitVersion>8.5.10</MassTransitVersion>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
    <EntityFrameworkCoreVersion>10.0.12</EntityFrameworkCoreVersion>
    <AspNetCoreVersion>10.0.12</AspNetCoreVersion>
    <!-- At least what JwtBearer 10.0.12 depends on: with transitive pinning on, anything lower is a downgrade. -->
    <IdentityModelVersion>8.19.2</IdentityModelVersion>
    <AzureFunctionsWorkerVersion>2.52.0</AzureFunctionsWorkerVersion>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <HotChocolateVersion>16.6.6</HotChocolateVersion>
    <FluentValidationVersion>12.1.1</FluentValidationVersion>
    <NewtonsoftJsonVersion>13.0.4</NewtonsoftJsonVersion>
    <MediatorVersion>3.0.2</MediatorVersion>
    <!--
      Tests and examples compile and run the generators on Roslyn 5. Not the newest: with transitive
      pinning on, this must be exactly the version Microsoft.EntityFrameworkCore.Design pins through
      Move it together with EntityFrameworkCoreVersion.
    -->
    <RoslynVersion>5.0.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <!-- The code fixes only; the generators must not depend on the Workspaces layer. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <!-- The resx-backed IStringLocalizerFactory. Tests and examples only: the toolkit asks for the abstraction. -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)" />
    <!-- Validating Supabase Auth's access tokens: DDDToolkit.Auth.Supabase and its two hosts. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="$(IdentityModelVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Core" Version="$(AzureFunctionsWorkerVersion)" />
    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="$(HotChocolateVersion)" />
    <!--
      HotChocolate 16 folded the execution engine and query validation into the HotChocolate
      package. HotChocolate.Execution was not released for 16 (its last version is the 16.0.0
      preview 16.0.0-p.10.45), so this line replaces it.
    -->
    <PackageVersion Include="HotChocolate" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="$(HotChocolateVersion)" />
    <!--
      The subscription transport used by the tests. At 16.6.6 there are also transports for Postgres
      (LISTEN/NOTIFY), Redis, RabbitMQ and NATS; the toolkit's sink works through ITopicEventSender and
      does not care which of them is registered.
    -->
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Types.Scalars" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="FluentValidation" Version="$(FluentValidationVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageVersion Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
    <!-- Wolverine and MassTransit are transports for DDDToolkit.Messaging.Wolverine and .MassTransit. -->
    <!-- MassTransit 8: the last major version under Apache 2.0. 9 is commercial; see the package README. -->
    <PackageVersion Include="MassTransit" Version="$(MassTransitVersion)" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="$(MassTransitVersion)" />
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="$(WolverineVersion)" />
    <!-- Wolverine compiles its handler code at start-up; since 6.x that compiler is a package of its own. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="$(WolverineVersion)" />
  </ItemGroup>

  <ItemGroup Label="Composition roots">
    <!--
      Mediator generates its implementation, its handler registrations and AddMediator into the
      assembly the generator runs in, so this belongs in the composition root only: the example host
      and the Mediator test project. Source/DDDToolkit.Mediator references the abstractions alone.
    -->
    <PackageVersion Include="Mediator.SourceGenerator" Version="$(MediatorVersion)" />
  </ItemGroup>

  <ItemGroup Label="Examples">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!--
    Aspire runs the example shop's hosts and their databases and brokers, and its testing package runs
    them end to end. Examples and tests only; nothing under Source/ depends on any of this, so there is
    no floor to keep.
  -->
  <PropertyGroup>
    <AspireVersion>13.5.4</AspireVersion>
    <OpenTelemetryVersion>1.19.1</OpenTelemetryVersion>
    <OpenTelemetryInstrumentationVersion>1.19.0</OpenTelemetryInstrumentationVersion>
  </PropertyGroup>

  <!-- Aspire.Hosting.AppHost is not listed: Aspire.AppHost.Sdk references it implicitly, at its own version. -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.10.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!--
      Fusion: the gateway of the microservices samples and the AppHost side that composes its schema, and
      the in-memory connector Tests/Spikes/DDDToolkit.Spikes.FusionInProcess tries.
      Pinned rather than $(HotChocolateVersion): only the examples use them, and Fusion's Aspire
      integration is newer than the floor the packages are built against.
    -->
    <PackageVersion Include="HotChocolate.Fusion.AspNetCore" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.Fusion.Aspire" Version="16.6.6" />
    <PackageVersion Include="HotChocolate.Fusion.Connectors.InMemory" Version="16.6.6" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryInstrumentationVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryInstrumentationVersion)" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- FluentAssertions 8+ is commercially licensed; 7.x is the last Apache-2.0 line. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.11" />
    <!--
      Real databases in throw-away containers: the provider suite runs the mapping tests on Postgres and
      SQL Server, and the pgmq sink needs a Postgres with that extension. Both suites skip themselves
      when Docker is absent, so a machine without it still goes green.
    -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>
</Project>
