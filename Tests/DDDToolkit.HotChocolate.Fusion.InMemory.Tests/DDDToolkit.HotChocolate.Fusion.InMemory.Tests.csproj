<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <!-- The modules' source schemas, as an application registers them. -->
    <PackageReference Include="HotChocolate.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\DDDToolkit.HotChocolate.Fusion.InMemory\DDDToolkit.HotChocolate.Fusion.InMemory.csproj" />
    <!-- The toolkit's conventions on the modules' source schemas: typed errors, enum spelling, shareable types. -->
    <ProjectReference Include="..\..\Source\DDDToolkit.HotChocolate\DDDToolkit.HotChocolate.csproj" />
    <!--
      A module written with HotChocolate's own generator, type classes over its application's records: the source
      schema whose entities another module references, and whose field carries a rule.
    -->
    <ProjectReference Include="..\DDDToolkit.HotChocolate.Tests.Gallery.Api\DDDToolkit.HotChocolate.Tests.Gallery.Api.csproj" />
  </ItemGroup>

  <!--
    The source schema of internal types that DDDToolkit.HotChocolate.Tests builds by itself. The same file is
    compiled here, so what is composed with a second schema is those types and not a copy.
  -->
  <ItemGroup>
    <Compile Include="..\DDDToolkit.HotChocolate.Tests\InternalTypes\DepotSchema.cs" LinkBase="InternalTypes" />
  </ItemGroup>

  <!--
    The batch dispatcher for a test that counts what a data loader's batch costs: one file for every suite that
    counts, so a batch is sent when it is whole in each of them and by the clock in none.
  -->
  <ItemGroup>
    <Compile Include="..\DDDToolkit.HotChocolate.Tests\Infrastructure\WholeBatches.cs" LinkBase="Infrastructure" />
  </ItemGroup>

  <!-- What a schema says of its types, and a printed schema read without it: one file for both suites. -->
  <ItemGroup>
    <Compile Include="..\DDDToolkit.HotChocolate.Tests\Infrastructure\SchemaDescriptions.cs" LinkBase="Infrastructure" />
  </ItemGroup>

</Project>
