<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A module's domain project, as a module split into projects by layer has one: its ids and a single value
    object, and no reference to HotChocolate, so nothing in this project can make a GraphQL scalar of them.
    DDDToolkit.HotChocolate.Tests runs against these rather than against ids that bind themselves, so it proves
    what a real build gives the module's API project for them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\DDDToolkit\DDDToolkit.csproj" />
  </ItemGroup>

  <!-- The generator. A NuGet consumer gets it through the package above; inside this repository it is wired by hand. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
