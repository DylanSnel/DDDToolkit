<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same module's API project: it builds the module's GraphQL schema, references HotChocolate, and declares no
    id of its own. The HotChocolate generator runs here, so this is where the ids of the domain project next to it
    are bound to their scalars: its generated AddHarborGraphQlRuntimeBindings() is all of that.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DTS.DDD.HotChocolate.Tests.Harbor.Domain\DTS.DDD.HotChocolate.Tests.Harbor.Domain.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.HotChocolate\DTS.DDD.HotChocolate.csproj" />
  </ItemGroup>

  <!-- Generators. A NuGet consumer gets these through the packages above; inside this repository they are wired by hand. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\DTS.DDD.Analyzers\DTS.DDD.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DTS.DDD.HotChocolate.Analyzers\DTS.DDD.HotChocolate.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
