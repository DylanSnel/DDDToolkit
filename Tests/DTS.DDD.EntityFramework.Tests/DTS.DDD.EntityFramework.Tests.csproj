<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DDD_Module>EfTests</DDD_Module>
    <!--
      Two events under one name and version fail the build (DDD00036). A few tests declare exactly that on
      purpose, to pin down that the registries still refuse it at start-up for code the build never saw.
    -->
    <NoWarn>$(NoWarn);DDD00036</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- The pgmq tests run against a real Postgres; they skip themselves when Docker is not there. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Examples\DTS.DDD.ExampleLibrary\DTS.DDD.ExampleLibrary.csproj" />
    <ProjectReference Include="..\..\Examples\DTS.DDD.ExampleApi\DTS.DDD.ExampleApi.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework\DTS.DDD.EntityFramework.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.Messaging.Postgres\DTS.DDD.Messaging.Postgres.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework.Postgres\DTS.DDD.EntityFramework.Postgres.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework.Supabase\DTS.DDD.EntityFramework.Supabase.csproj" />
    <!--
      Row level security from a caller: a request on Kestrel with a bearer token, an Azure Functions
      invocation through the worker middleware, and the token validator on its own, all against the same
      Postgres as the rest.
    -->
    <ProjectReference Include="..\..\Source\DTS.DDD.Auth.Supabase\DTS.DDD.Auth.Supabase.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.Auth.Supabase.AspNetCore\DTS.DDD.Auth.Supabase.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.Auth.Supabase.AzureFunctions\DTS.DDD.Auth.Supabase.AzureFunctions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The Supabase export's build step, which a test runs through MSBuild against this assembly: the test
    assembly carries a hand-written copy of the module initializer the generator writes into a host.
  -->
  <ItemGroup>
    <None Include="..\..\Source\DTS.DDD.EntityFramework.Supabase\buildTransitive\DTS.DDD.EntityFramework.Supabase.targets" Link="BuildStep\DTS.DDD.EntityFramework.Supabase.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\DTS.DDD.Analyzers\DTS.DDD.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework.Analyzers\DTS.DDD.EntityFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
