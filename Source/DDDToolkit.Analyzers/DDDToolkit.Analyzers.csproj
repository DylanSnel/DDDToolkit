<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- The assembly ships in analyzers/dotnet/cs rather than lib/, so there is nothing for a symbol
         package to describe. Leaving the inherited IncludeSymbols on makes pack fail with NU5017. -->
    <IncludeSymbols>false</IncludeSymbols>
    <Title>Domain Driven Design Toolkit - Analyzers</Title>
    <PackageTags>ddd;domain;driven;design;toolkit;generators</PackageTags>
    <Description>Source generators for the DDDToolkit: entities, aggregate roots, entity ids, value objects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\DDDToolkit.Analyzers.Shared\DDDToolkit.Analyzers.Shared.props" />

  <!--
    The code fixes live in an assembly of their own, because they need the Workspaces layer and the
    compiler does not load it. Built first and packed beside the generators, so the IDE finds both.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DDDToolkit.Analyzers.CodeFixes\DDDToolkit.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The MSBuild properties the generators read, declared in the package that carries the generators, and the
    build step that writes the module DDD_DeclareModule declares into the project. Named after the package,
    because that is the only build/*.props, build/*.targets and their buildTransitive/ twins NuGet imports.
    build/ reaches a project that references this package itself; buildTransitive/ reaches one that gets it
    through DDDToolkit, another package or a project reference.
  -->
  <ItemGroup>
    <None Update="build\DDDToolkit.Analyzers.props" Pack="true" PackagePath="build/$(PackageId).props;buildTransitive/$(PackageId).props" />
    <None Update="build\DDDToolkit.Analyzers.targets" Pack="true" PackagePath="build/$(PackageId).targets;buildTransitive/$(PackageId).targets" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\DDDToolkit.Analyzers.CodeFixes\$(OutputPath)\DDDToolkit.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
