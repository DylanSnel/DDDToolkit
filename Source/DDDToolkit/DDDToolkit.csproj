<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Domain Driven Design Toolkit</Title>
    <PackageTags>ddd;domain;driven;design;toolkit</PackageTags>
    <Description>Base types and source generators that make domain driven design in .NET less repetitive: entities, aggregate roots, strongly typed ids, value objects and domain events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- Named after the package, because that is the only build/*.props NuGet imports into a consumer. -->
  <ItemGroup>
    <None Update="DDDToolkit.props" Pack="true" PackagePath="build/$(PackageId).props" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDDToolkit.Abstractions\DDDToolkit.Abstractions.csproj" />
    <!-- Referenced so the NuGet package depends on the generator package; the assembly is not used at run time. -->
    <ProjectReference Include="..\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

</Project>
