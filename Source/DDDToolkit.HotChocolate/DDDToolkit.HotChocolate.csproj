<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Domain Driven Design Toolkit - HotChocolate GraphQL</Title>
    <PackageTags>ddd;domain;driven;design;toolkit;hot;chocolate;hotchocolate;graphql</PackageTags>
    <Description>HotChocolate GraphQL integration for the DDDToolkit: runtime type bindings and converters for strongly typed ids and value objects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.Types.Analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDDToolkit.Abstractions\DDDToolkit.Abstractions.csproj" />
    <ProjectReference Include="..\DDDToolkit.HotChocolate.Analyzers\DDDToolkit.HotChocolate.Analyzers.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\DDDToolkit\DDDToolkit.csproj" />
  </ItemGroup>

</Project>
