<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>Domain Driven Design Toolkit - HotChocolate Fusion in memory</Title>
    <PackageTags>ddd;domain;driven;design;toolkit;hotchocolate;graphql;fusion;modular;monolith</PackageTags>
    <Description>One GraphQL schema over the modules of a modular monolith: every module serves a source schema of its own, and a HotChocolate Fusion gateway composes them in the process and calls them in memory, with no HTTP. Requires HotChocolate Fusion 16.6.6 or later.</Description>
  </PropertyGroup>

  <!--
    HotChocolate Fusion 16.6.6 or later: the version this package was written and tested against. The
    dependencies below declare it, so NuGet refuses an older Fusion rather than a gateway that fails at run
    time. DDDToolkit.HotChocolate asks for the same version, because the HotChocolate packages of one
    application are one version: Directory.Packages.props has one property for all of them.

    It relies on public but low-level Fusion classes (InMemoryConfigurationProvider,
    InMemorySourceSchemaClientFactory, FusionSetupUtilities), because AddInMemorySchema cannot serve a
    gateway over HTTP next to more than one source schema in one service container. See the README.
  -->
  <ItemGroup>
    <PackageReference Include="HotChocolate.Fusion.AspNetCore" />
    <PackageReference Include="HotChocolate.Fusion.Connectors.InMemory" />
  </ItemGroup>

</Project>
