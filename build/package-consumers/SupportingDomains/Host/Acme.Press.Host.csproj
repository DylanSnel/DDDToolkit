<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The host: an application with no package reference and no module of its own, only the infrastructure
    project. NuGet hands it the analyzers of every package below it, Membership's two generators among them, so
    they run here as well, and must write nothing here: what they write belongs to the projects below, where the
    classes and the contexts are. The script checks that they arrived here and wrote nothing.

    The Supabase package's build step and generator arrive the same way, through the infrastructure project, and
    this is where they work: the host turns the export on, as docs/supabase.md has it, and every build writes the
    access files of the two contexts into ../supabase/migrations. The script also gives the property for the whole
    build, the way a CI script does, and holds that it then reaches this project and no other.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SupabaseMigrationsExport>Write</SupabaseMigrationsExport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Acme.Press.Infrastructure.csproj" />
  </ItemGroup>

</Project>
