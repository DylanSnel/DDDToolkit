<Project>
  <!--
    What the consumers in this folder share. build/verify-package-consumption.sh builds them from
    a copy outside the repository, so the repository's own Directory.Build.props and Directory.Build.targets,
    which import the props and the targets of DTS.DDD.Analyzers for every project below them, never reach
    them: DDD_Module reaches their generators, and declares their module, through the packages or not at all.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- The version the packages were packed under. The script passes it. -->
    <DDDToolkitPackageVersion Condition="'$(DDDToolkitPackageVersion)' == ''">0.0.0-ci</DDDToolkitPackageVersion>
  </PropertyGroup>
</Project>
