<Project>
  <!--
    The build step of the DTS.DDD.Analyzers package: DDD_Module declares the project's module. A NuGet consumer
    gets this file from the package, as build/ and buildTransitive/<package id>.targets.
    The projects in this repository reference the generators as projects and never restore that package, so the same
    file is imported here, as Directory.Build.props imports its props file.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Source\DTS.DDD.Analyzers\build\DTS.DDD.Analyzers.targets" />
</Project>
