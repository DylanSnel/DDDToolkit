<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Module Benchmarks, which also names the generated AddBenchmarksConverters method. -->
    <DDD_Module>Benchmarks</DDD_Module>
    <!--
      BenchmarkDotNet refuses to measure a Debug build, so the numbers in docs/performance.md come
      from `dotnet run -c Release`. The Debug configuration still compiles, which is what keeps the
      benchmarks honest: they break with the rest of the solution when the generators change.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!--
      The access check benchmarks name the classes of the Membership and Tenancy test hosts, which belong to the modules
      Filing and Tenancy. A benchmark is no module of the application, so the module boundary does not apply to it.
    -->
    <NoWarn>$(NoWarn);DDD00022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- The round-trip benchmarks run on Postgres in a container as well, to measure what a statement costs over a socket. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\DDDToolkit\DDDToolkit.csproj" />
    <ProjectReference Include="..\..\Source\DDDToolkit.EntityFramework\DDDToolkit.EntityFramework.csproj" />
    <!--
      The access check benchmarks ask Membership and Tenancy about the resources and tenants of the test hosts. Each
      host is the smallest application that declares the package's classes, with the code its generators write.
    -->
    <ProjectReference Include="..\..\Tests\DDDToolkit.Supporting.Membership.TestHost\DDDToolkit.Supporting.Membership.TestHost.csproj" />
    <ProjectReference Include="..\..\Tests\DDDToolkit.Supporting.Tenancy.TestHost\DDDToolkit.Supporting.Tenancy.TestHost.csproj" />
  </ItemGroup>

  <!-- Generators. NuGet consumers get these transitively through the packages above. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DDDToolkit.EntityFramework.Analyzers\DDDToolkit.EntityFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
