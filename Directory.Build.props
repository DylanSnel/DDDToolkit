<Project>
  <PropertyGroup>
    <Authors>Dylan Snel</Authors>
    <Copyright>Dylan Snel</Copyright>
    <PackageProjectUrl>https://github.com/DylanSnel/DDDToolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DylanSnel/DDDToolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ddd;domain;driven;design;toolkit</PackageTags>
    <PackageLanguage>en-US</PackageLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>DDDToolkit-Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>3.1.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Source Link ships with the .NET 8+ SDK; no package reference needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    The package ids. For now 3.x is published as Temp.DDDToolkit.*, from a second nuget.org
    account, because the account that owns the DDDToolkit.* ids cannot publish at the moment. Only the
    id changes: assembly names and namespaces stay DDDToolkit.*, so a consumer changes the
    PackageReference and nothing else. Once the old ids can be published again, empty the prefix and
    every package goes back to its own name, dependencies between them included, since NuGet takes
    those from the referenced project's PackageId.

    Anything that names a package by its id has to follow this:
    - the build and buildTransitive props in DDDToolkit.Analyzers, which declare the MSBuild properties
      the generators read;
    - the buildTransitive targets in DDDToolkit.EntityFramework.Supabase, the export's build step;
    - build/verify-package-consumption.sh and the consumers it builds.
    NuGet only imports the first two when they are named after the package.
  -->
  <PropertyGroup>
    <DDDPackageIdPrefix>Temp.</DDDPackageIdPrefix>
    <PackageId>$(DDDPackageIdPrefix)$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)DDDToolkit-Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The MSBuild properties the DDDToolkit generators read. A NuGet consumer gets this file from the
    DDDToolkit.Analyzers package, as build/ and buildTransitive/<package id>.props. The projects in
    this repository reference the generators as projects and never restore that package, so the same
    file is imported here. A property a generator reads is declared in that file, not here.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Source\DDDToolkit.Analyzers\build\DDDToolkit.Analyzers.props" />
</Project>
