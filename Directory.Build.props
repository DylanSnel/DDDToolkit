<Project>
  <PropertyGroup>
    <Authors>Dylan Snel</Authors>
    <Copyright>Dylan Snel</Copyright>
    <PackageProjectUrl>https://github.com/DylanSnel/DDDToolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DylanSnel/DDDToolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ddd;domain;driven;design;toolkit</PackageTags>
    <PackageLanguage>en-US</PackageLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>DDDToolkit-Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Source Link ships with the .NET 8+ SDK; no package reference needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    The package ids. A project named DTS.DDD.EntityFramework is the package DylansTechStack.DDD.EntityFramework:
    the namespaces and the assemblies are DTS.*, and the ids are DylansTechStack.*, a prefix that can be reserved
    on nuget.org. Dependencies between the packages follow, since NuGet takes them from the referenced project's
    PackageId. A project whose name does not start with DTS. is no package and keeps the SDK's default.

    The build and buildTransitive files that NuGet imports by the package's name are packed under $(PackageId),
    in DTS.DDD.Analyzers and DTS.DDD.EntityFramework.Supabase, so they follow by themselves.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('DTS.'))">
    <PackageId>DylansTechStack.$(MSBuildProjectName.Substring(4))</PackageId>
  </PropertyGroup>

  <!--
    The XML documentation file, which pack puts beside the assembly in lib/<tfm>/. It is where Visual Studio
    and every other editor read a package's /// comments from: without it a consumer sees none of them,
    however well the source is documented, and the symbols and Source Link do not change that.

    Every project under Source is a package or ships inside one; the tests, samples and benchmarks are
    neither. The generators and code fixes, the *.Analyzers and *.CodeFixes projects, are left out: they
    ship in analyzers/dotnet/cs, where the compiler and the IDE load them and nothing references them, so
    nothing would read their XML. What a generator writes keeps its comments in the code it writes: in a
    consumer's project the editor reads them there, and where a generator writes into one of these
    packages, as it writes Tenancy's parents, they land in that package's XML.

    With the file comes CS1591 for a public member without a comment. The packages are documented
    throughout and keep it, so a new member says so; the three that still have such members, the core,
    Abstractions and Newtonsoft.Json, turn it off in their own project file, where NoWarn already holds
    the SDK's defaults.
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)Source')) and !$(MSBuildProjectName.EndsWith('.Analyzers')) and !$(MSBuildProjectName.EndsWith('.CodeFixes'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)DDDToolkit-Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The MSBuild properties the DDDToolkit generators read. A NuGet consumer gets this file from the
    DTS.DDD.Analyzers package, as build/ and buildTransitive/<package id>.props. The projects in
    this repository reference the generators as projects and never restore that package, so the same
    file is imported here. A property a generator reads is declared in that file, not here.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Source\DTS.DDD.Analyzers\build\DTS.DDD.Analyzers.props" />
</Project>
