<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately outside DDDToolkit.slnx. This project consumes the toolkit as PACKAGES, so it cannot
    build until they have been packed. build/verify-package-consumption.sh does that and then builds
    this, and the Build and Test workflow runs it on every pull request.

    Central package management is off here on purpose: a consumer of the published packages does not
    get this repository's Directory.Packages.props, and pinning the versions in the file that declares
    the references is what a real consumer's project looks like.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The version the verification script packed. Override with -p:DDDToolkitPackageVersion=. -->
    <DDDToolkitPackageVersion Condition="'$(DDDToolkitPackageVersion)' == ''">0.0.0-ci</DDDToolkitPackageVersion>

    <!--
      The property under test. A consumer sets it in the project file or in their own
      Directory.Build.props, and it only reaches the generator through build/DDDToolkit.props inside
      the DDDToolkit package. Check.cs names the method it is supposed to produce, so a build failure
      here means that path is broken.
    -->
    <DDD_Module>NugetTest</DDD_Module>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only these three. The four analyzer packages are NOT referenced: each has to arrive as a
      dependency of the package above it, which is the other half of what this project verifies.
    -->
    <PackageReference Include="DDDToolkit" Version="$(DDDToolkitPackageVersion)" />
    <PackageReference Include="DDDToolkit.EntityFramework" Version="$(DDDToolkitPackageVersion)" />
    <PackageReference Include="DDDToolkit.FluentValidation" Version="$(DDDToolkitPackageVersion)" />
  </ItemGroup>

</Project>
