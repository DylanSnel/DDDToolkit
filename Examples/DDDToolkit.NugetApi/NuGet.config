<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      clear matters. Without it the published DDDToolkit on nuget.org is also a candidate, and a
      restore that silently picked 2.0.22 would make this project prove nothing.
    -->
    <clear />
    <add key="local" value="../../nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
