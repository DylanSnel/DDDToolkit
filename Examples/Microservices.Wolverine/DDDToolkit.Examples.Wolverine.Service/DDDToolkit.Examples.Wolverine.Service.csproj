<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- Wolverine generates and compiles its handler adapters at start-up. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\DDDToolkit.Examples.Microservices\DDDToolkit.Examples.Microservices.csproj" />
    <ProjectReference Include="..\..\Shared\DDDToolkit.Examples.ServiceDefaults\DDDToolkit.Examples.ServiceDefaults.csproj" />
    <!-- Storefront runs on SQL Server in this sample; the migrations are only loaded there. -->
    <ProjectReference Include="..\..\Modules\Migrations.SqlServer\DDDToolkit.Examples.Migrations.SqlServer\DDDToolkit.Examples.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Mediator\DDDToolkit.Mediator.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Messaging.Wolverine\DDDToolkit.Messaging.Wolverine.csproj" />
  </ItemGroup>

</Project>
