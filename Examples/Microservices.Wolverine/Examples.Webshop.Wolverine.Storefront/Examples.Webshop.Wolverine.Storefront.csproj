<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mediator generates into the composition root. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <!-- Wolverine generates and compiles its handler adapters at start-up. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <!--
    Catalog and Ordering, and no other module: this service cannot call into a module it does not run, because it does
    not reference it. What it knows of the others is their contracts, through the modules it runs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Catalog\Examples.Webshop.Catalog\Examples.Webshop.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Ordering\Examples.Webshop.Ordering\Examples.Webshop.Ordering.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Examples.Webshop.Catalog.Migrations.SqlServer\Examples.Webshop.Catalog.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\Modules\Ordering\Examples.Webshop.Ordering.Migrations.SqlServer\Examples.Webshop.Ordering.Migrations.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Examples.ServiceDefaults\Examples.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Mediator\DDDToolkit.Mediator.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Messaging.Wolverine\DDDToolkit.Messaging.Wolverine.csproj" />
  </ItemGroup>

</Project>
