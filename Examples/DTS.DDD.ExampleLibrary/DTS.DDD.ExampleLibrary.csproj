<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Name used for the generated Add<Module>Converters / Add<Module>GraphQlRuntimeBindings methods. The library
      holds what the API project shares with it, value objects and the event interface, so it is no module of its
      own: a shared kernel, which keeps the name and leaves the module out with DDD_DeclareModule set to false.
    -->
    <DDD_Module>Common</DDD_Module>
    <DDD_DeclareModule>false</DDD_DeclareModule>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <!-- Abstractions only: the Mediator source generator belongs in the composition root, not here. -->
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="HotChocolate.Types.Scalars" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\DTS.DDD\DTS.DDD.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework\DTS.DDD.EntityFramework.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.FluentValidation\DTS.DDD.FluentValidation.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.HotChocolate\DTS.DDD.HotChocolate.csproj" />
    <ProjectReference Include="..\..\Source\DTS.DDD.NewtonSoft.Json\DTS.DDD.NewtonSoft.Json.csproj" />
  </ItemGroup>

  <!-- Generators. NuGet consumers get these transitively through the packages above. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\DTS.DDD.Analyzers\DTS.DDD.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DTS.DDD.EntityFramework.Analyzers\DTS.DDD.EntityFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DTS.DDD.FluentValidation.Analyzers\DTS.DDD.FluentValidation.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\DTS.DDD.HotChocolate.Analyzers\DTS.DDD.HotChocolate.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
