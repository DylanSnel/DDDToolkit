<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A live Supabase project's connection string goes here, never in the repository; see Program.cs. -->
    <UserSecretsId>dddtoolkit-examples-supabase-apphost</UserSecretsId>
    <!-- ASPIRE010 asks for the Aspire CLI bundle, which only the CLI's own features need. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDDToolkit.Examples.Host\DDDToolkit.Examples.Host.csproj" />
  </ItemGroup>

</Project>
