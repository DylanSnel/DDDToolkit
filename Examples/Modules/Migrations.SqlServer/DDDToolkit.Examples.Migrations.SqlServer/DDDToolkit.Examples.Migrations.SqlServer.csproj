<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- dotnet ef runs this project as its own startup project, which needs a runtime configuration. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <!--
    Every module's SQL Server migrations, in one assembly apart from the modules.

    A module's Postgres migrations live in the module, because Supabase is where the example started and
    the export reads them there. A second provider cannot live next to them: Entity Framework keeps one
    model snapshot per context per assembly, and a Postgres snapshot and a SQL Server snapshot of the same
    context disagree on every column type. So SQL Server gets an assembly of its own, and
    ModuleDatabase.UseSqlServer points each context at it with MigrationsAssembly. A host that runs on SQL
    Server references this project; a host that does not never loads it.

    Not a module: it names every module's context, which is exactly what a module may not do.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Catalog\DDDToolkit.Examples.Catalog\DDDToolkit.Examples.Catalog.csproj" />
    <ProjectReference Include="..\..\Ordering\DDDToolkit.Examples.Ordering\DDDToolkit.Examples.Ordering.csproj" />
    <ProjectReference Include="..\..\Inventory\DDDToolkit.Examples.Inventory\DDDToolkit.Examples.Inventory.csproj" />
    <ProjectReference Include="..\..\Payments\DDDToolkit.Examples.Payments\DDDToolkit.Examples.Payments.csproj" />
    <ProjectReference Include="..\..\Shipping\DDDToolkit.Examples.Shipping\DDDToolkit.Examples.Shipping.csproj" />
    <ProjectReference Include="..\..\..\Shared\DDDToolkit.Examples.Hosting\DDDToolkit.Examples.Hosting.csproj" />
  </ItemGroup>

</Project>
