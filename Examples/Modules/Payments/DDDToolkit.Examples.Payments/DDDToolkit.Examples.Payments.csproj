    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DDD_Module>Payments</DDD_Module>
    <WarningsAsErrors>$(WarningsAsErrors);DDD00022;DDD00023</WarningsAsErrors>
