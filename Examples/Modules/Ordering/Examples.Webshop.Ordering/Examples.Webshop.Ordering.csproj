<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Ordering now reads three other modules' contracts, so it holds the same line Shipping does. -->
    <WarningsAsErrors>$(WarningsAsErrors);DDD00022;DDD00023</WarningsAsErrors>
  </PropertyGroup>

  <!-- The module maps its own HTTP endpoints, so that every host running it serves the same API. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain events are published through Mediator, so they implement its INotification. Abstractions
         only: the Mediator generator belongs in the composition root, which is the host. -->
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Examples.Webshop.Ordering.Contracts\Examples.Webshop.Ordering.Contracts.csproj" />
    <!-- The contracts Ordering reacts to: prices, reservations, payments. Contracts only, never a module. -->
    <ProjectReference Include="..\..\Catalog\Examples.Webshop.Catalog.Contracts\Examples.Webshop.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\..\Inventory\Examples.Webshop.Inventory.Contracts\Examples.Webshop.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\Payments\Examples.Webshop.Payments.Contracts\Examples.Webshop.Payments.Contracts.csproj" />
    <ProjectReference Include="..\..\SharedKernel\Examples.Webshop.SharedKernel\Examples.Webshop.SharedKernel.csproj" />
    <!-- Where the module's tables live is the host's choice, made through ModuleDatabase. -->
    <ProjectReference Include="..\..\..\Shared\Examples.Hosting\Examples.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit\DDDToolkit.csproj" />
    <!-- GraphQL: the schema types in Api/GraphQL, and the generated bindings that print this assembly's ids as UUIDs. -->
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.HotChocolate\DDDToolkit.HotChocolate.csproj" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework\DDDToolkit.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's migrations are Postgres migrations, exported for Supabase. See
         Infrastructure/Persistence/Migrations and the design-time factory next to the context. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework.Supabase\DDDToolkit.EntityFramework.Supabase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework.Analyzers\DDDToolkit.EntityFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.HotChocolate.Analyzers\DDDToolkit.HotChocolate.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
