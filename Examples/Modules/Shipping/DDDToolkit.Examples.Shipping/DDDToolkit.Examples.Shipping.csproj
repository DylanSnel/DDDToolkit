<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Names the generated AddShippingConverters method. See docs/getting-started.md. -->
    <DDD_Module>Shipping</DDD_Module>
    <!--
      The boundary rules are warnings by default, so that a codebase adopting modules can see the list
      before it has to fix it. This example's list is empty, so it holds the line here instead.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);DDD00022;DDD00023</WarningsAsErrors>
  </PropertyGroup>

  <!-- The module maps its own HTTP endpoints, so that every host running it serves the same API. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The one reference that matters: Ordering's CONTRACTS, never Ordering itself. Add
    DDDToolkit.Examples.Ordering here and Shipping could hold an Order, query one, and save into
    Ordering's tables inside its own transaction. Nothing would look wrong and the two modules would be
    one module with extra folders.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Ordering\DDDToolkit.Examples.Ordering.Contracts\DDDToolkit.Examples.Ordering.Contracts.csproj" />
    <!-- Where the module's tables live is the host's choice, made through ModuleDatabase. -->
    <ProjectReference Include="..\..\..\Shared\DDDToolkit.Examples.Hosting\DDDToolkit.Examples.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit\DDDToolkit.csproj" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework\DDDToolkit.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's migrations are Postgres migrations, exported for Supabase. See
         Infrastructure/Persistence/Migrations and the design-time factory next to the context. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework.Supabase\DDDToolkit.EntityFramework.Supabase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\Source\DDDToolkit.EntityFramework.Analyzers\DDDToolkit.EntityFramework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
