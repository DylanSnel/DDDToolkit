{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products": {
        "ClusterId": "storefront",
        "Match": {
          "Path": "/products/{**rest}"
        }
      },
      "products-root": {
        "ClusterId": "storefront",
        "Match": {
          "Path": "/products"
        }
      },
      "orders": {
        "ClusterId": "storefront",
        "Match": {
          "Path": "/orders/{**rest}"
        }
      },
      "orders-root": {
        "ClusterId": "storefront",
        "Match": {
          "Path": "/orders"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/payments/{**rest}"
        }
      },
      "payments-root": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/payments"
        }
      },
      "stock": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/stock/{**rest}"
        }
      },
      "stock-root": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/stock"
        }
      },
      "reservations": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/reservations/{**rest}"
        }
      },
      "reservations-root": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/reservations"
        }
      },
      "shipments": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/shipments/{**rest}"
        }
      },
      "shipments-root": {
        "ClusterId": "fulfilment",
        "Match": {
          "Path": "/shipments"
        }
      }
    },
    "Clusters": {
      "storefront": {
        "Destinations": {
          "storefront": {
            "Address": "http://storefront"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments": {
            "Address": "http://payments"
          }
        }
      },
      "fulfilment": {
        "Destinations": {
          "fulfilment": {
            "Address": "http://fulfilment"
          }
        }
      }
    }
  }
}
