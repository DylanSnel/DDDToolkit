<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>examples-tenancy-apphost</UserSecretsId>
    <!-- ASPIRE010 asks for the Aspire CLI bundle, which only the CLI's own features need. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <!--
    The two processes. Everything else is a container: Program.cs starts Supabase's own images as plain
    containers, which needs no hosting package of its own, so what running this project needs is Docker.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Examples.Tenancy.Host\Examples.Tenancy.Host.csproj" />
    <ProjectReference Include="..\Examples.Tenancy.Ui\Examples.Tenancy.Ui.csproj" />
  </ItemGroup>

  <!-- Writes the token with the service role that a bare Auth server takes where a project has its secret key. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

</Project>
