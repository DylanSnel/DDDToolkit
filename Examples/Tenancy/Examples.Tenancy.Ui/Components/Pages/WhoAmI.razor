@page "/"
@inherits SessionPage

<PageTitle>@T["nav.who-am-i"] · Tenancy sample</PageTitle>

<h1>@T["nav.who-am-i"]</h1>
<p class="text-body-secondary">@T.Html("whoami.intro", Session.PersonName, Session.Tenant ?? T["common.no-tenant"])</p>

@if (_me is null)
{
    <p><em>@T["common.loading"]</em></p>
}
else if (_me.Value is not { } me)
{
    <p>@T["whoami.no-answer"]</p>
    <ApiOutcomeView Answer="_me" />
}
else
{
    <div class="facts">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 card-title">@T["common.tenant"]</h2>
                <div><strong>@me.TenantName</strong> <code>@me.Tenant.Slug</code></div>
                <div class="small">@T["whoami.shape-status", me.Tenant.Shape, me.Tenant.Status]</div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h2 class="h6 card-title">@T["whoami.seat"]</h2>
                <div><strong>@me.Seat.DisplayName</strong></div>
                <div class="small">@T["whoami.seat-status", me.Seat.Status]</div>
            </div>
        </div>
    </div>

    <h2 class="h5 mt-4">@T["whoami.placements"]</h2>
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr><th>@T["whoami.placed-at"]</th><th>@T["common.role"]</th><th>@T["common.from"]</th><th>@T["common.until"]</th><th>@T["whoami.applies-now"]</th></tr>
            </thead>
            <tbody>
                @foreach (var placement in me.Placements.OrderByDescending(placement => placement.IsPrimary).ThenBy(placement => me.PathOf(placement.UnitId), StringComparer.OrdinalIgnoreCase))
                {
                    if (placement.Grants.Count == 0)
                    {
                        <tr>
                            <td>@PlacedAt(me, placement)</td>
                            <td colspan="4" class="text-body-secondary">@T["whoami.no-role-here"]</td>
                        </tr>
                    }

                    var grants = placement.Grants.OrderBy(grant => me.NameOf(grant.RoleId), StringComparer.OrdinalIgnoreCase).ToList();
                    for (var index = 0; index < grants.Count; index++)
                    {
                        var grant = grants[index];
                        var applies = me.AppliesNow(grant);
                        var struck = applies ? null : "not-applying";
                        <tr>
                            <td>
                                @if (index == 0)
                                {
                                    @PlacedAt(me, placement)
                                }
                            </td>
                            <td class="@struck">@me.NameOf(grant.RoleId)</td>
                            <td class="@struck">@Day(grant.StartsAt)</td>
                            <td class="@struck">@(grant.EndsAt is { } ends ? UntilDay.Shown(ends) : T["common.open-ended"])</td>
                            <td>@Applies(applies, grant)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5 mt-4">@T["whoami.roles"]</h2>
    @if (me.Roles.Count == 0)
    {
        <p class="text-body-secondary">@T["whoami.roles.none"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>@T["common.role"]</th><th>@T["whoami.from-starter-role"]</th><th>@T["common.status"]</th><th>@T["whoami.manages-access"]</th><th>@T["whoami.permissions"]</th></tr></thead>
                <tbody>
                    @foreach (var role in me.Roles)
                    {
                        var listed = _listed.GetValueOrDefault(role.Id) ?? role;
                        <tr>
                            <td>@role.Name</td>
                            <td><code>@role.FromStarterRole</code></td>
                            <td>@role.Status</td>
                            <td>@(listed.ManagesAccess ? T["common.yes"] : T["common.no"])</td>
                            <td><div class="permissions">@foreach (var key in listed.PermissionsShown) { <code>@key</code> }</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (me.Permissions.Any(held => held.Permission == GrantsManage))
    {
        <p class="small text-body-secondary">@T.Html("whoami.grants-manage", GrantsManage)</p>
    }

    @if (me.Permissions.Any(held => held.Permission == SeatsManage && held.AtTenant))
    {
        <p class="small text-body-secondary">@T.Html("whoami.seats-manage", SeatsManage)</p>
    }

    @if (me.Permissions.Any(held => held.Permission == UnitsManage))
    {
        <p class="small text-body-secondary">@T.Html("whoami.units-manage", UnitsManage)</p>
    }

    <h2 class="h5 mt-4">@T["whoami.permissions-now"]</h2>
    @if (me.Permissions.Count == 0)
    {
        <p class="text-body-secondary">@T["whoami.permissions-now.none"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>@T["whoami.permission"]</th><th>@T["whoami.granted-at"]</th><th>@T["whoami.reaches"]</th></tr></thead>
                <tbody>
                    @foreach (var held in me.Permissions)
                    {
                        <tr>
                            <td><code>@held.Permission</code></td>
                            <td>@string.Join("; ", held.GrantedAt.Select(unit => unit.Path))</td>
                            <td>
                                @if (held.AtTenant)
                                {
                                    <span class="badge text-bg-info">@T["whoami.whole-tenant"]</span>
                                }
                                else
                                {
                                    <ul class="paths">@foreach (var unit in held.Reaches) { <li>@unit.Path</li> }</ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // Tenancy's permissions for giving roles, managing seats and moving units. The UI knows the API by its wire, so the
    // permissions are written out here.
    private const string GrantsManage = "tenancy.grants.manage";
    private const string SeatsManage = "tenancy.seats.manage";
    private const string UnitsManage = "tenancy.units.manage";

    private ApiOutcome<WhoAmIAnswer>? _me;

    // The seat's roles as the directory answers them by id: whether each manages access, and its permissions for
    // whoever manages the tenant's roles. The overview names the roles and says neither. Not the session's last answer.
    private IReadOnlyDictionary<Guid, RoleInfo> _listed = new Dictionary<Guid, RoleInfo>();

    protected override async Task LoadAsync()
    {
        _me = await Api.WhoAmIAsync();
        _listed = _me.Value is { Roles.Count: > 0 } me
            && (await Api.RolesByIdAsync([.. me.Roles.Select(role => role.Id)])).Value is { } roles
                ? roles.ToDictionary(role => role.Id)
                : new Dictionary<Guid, RoleInfo>();
    }

    private RenderFragment PlacedAt(WhoAmIAnswer me, PlacementInfo placement) =>
        @<span>
            @me.PathOf(placement.UnitId)
            @if (placement.IsPrimary)
            {
                <span class="badge text-bg-light">@T["whoami.primary"]</span>
            }
        </span>;

    // An expired grant is the demonstration's point: say why it does not apply, not only that it does not.
    private string Applies(bool applies, GrantInfo grant)
        => applies ? T["common.yes"]
            : grant.EndsAt is { } ends && ends <= DateTimeOffset.UtcNow ? T["whoami.ended"]
            : T["whoami.not-started"];

    private static string Day(DateTimeOffset moment) => moment.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture);
}
