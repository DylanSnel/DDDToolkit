@inject SupabaseLoginClient SupabaseLogin
@inject SampleApi Api
@inject UiSession Session
@inject NavigationManager Navigation

@*
    The real sign-in, at Supabase Auth: an e-mail address and a password. It renders nothing where the UI knows no
    Auth server, which leaves the login page with the dev login alone. The password goes to Auth and is kept
    nowhere; the token stays in the circuit's session, as the dev login's does. Its texts are the UI's own, in the
    session's language, and so is what the client tells a person who is refused.
*@
@if (SupabaseLogin.IsOffered)
{
    <h2 class="h5">@T["login.password.title"]</h2>
    <p class="small text-body-secondary">@T.Html("login.password.intro")</p>
    <form class="row g-2 align-items-end mb-3" @onsubmit="SignInAsync">
        <div class="col-sm-4">
            <label class="form-label small" for="login-email">@T["login.password.email"]</label>
            <input id="login-email" type="email" class="form-control form-control-sm" autocomplete="username" @bind="_email" />
        </div>
        <div class="col-sm-4">
            <label class="form-label small" for="login-password">@T["login.password.password"]</label>
            <input id="login-password" type="password" class="form-control form-control-sm" autocomplete="current-password" @bind="_password" />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary btn-sm" disabled="@_signingIn">@(_signingIn ? T["login.signing-in"] : T["login.password.sign-in"])</button>
        </div>
    </form>

    @if (_refused is not null)
    {
        <div class="alert alert-danger" role="alert">@_refused</div>
    }

    @if (_failed is not null)
    {
        <p class="small">@T["login.password.token-refused"]</p>
        <ApiOutcomeView Answer="_failed" />
    }

    <h2 class="h5 mt-4">@T["login.password.or-dev-login"]</h2>
}

@code {
    private string? _email;
    private string? _password;
    private string? _refused;
    private ApiOutcome? _failed;
    private bool _signingIn;

    // The same two steps as the dev login: a token, then the person's own seats with it, so the session starts in
    // a tenant. The password is forgotten as soon as it was sent, whatever the answer.
    private async Task SignInAsync()
    {
        if (_signingIn)
        {
            return;
        }

        _signingIn = true;
        _refused = null;
        _failed = null;
        try
        {
            var email = _email?.Trim();
            var signedIn = await SupabaseLogin.SignInAsync(email, _password);
            _password = null;
            if (signedIn.Answer is not { } answer)
            {
                _refused = signedIn.Refusal;
                return;
            }

            // Auth and the API are two servers: a token the API does not take is shown as the API's answer, rather
            // than starting a session that ends at the next call.
            var seats = await Api.SeatsOfMineAsync(CallAs.Person(email!, answer.AccessToken));
            if (seats.Value is not { } mine)
            {
                _failed = seats;
                return;
            }

            Session.SignIn(email!, answer.User?.Email ?? email!, answer.AccessToken, answer.Expires, UiSession.TenantToStartIn(mine));
            Navigation.NavigateTo("");
        }
        finally
        {
            _signingIn = false;
        }
    }
}
