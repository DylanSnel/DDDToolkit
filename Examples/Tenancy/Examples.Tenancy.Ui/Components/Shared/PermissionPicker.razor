@*
    Permissions of the catalogue to pick, each by its text with what it does as its title. Every permission that is not retired is
    offered, whichever the API would take: one it refuses is something to try.
*@
<div class="permission-picker">
    @foreach (var permission in Permissions)
    {
        <label class="form-check form-check-inline small" title="@permission.Description">
            <input class="form-check-input" type="checkbox" checked="@Picked.Contains(permission.Name)" @onchange="change => Pick(permission.Name, change)" />
            <code>@permission.Name</code>
        </label>
    }
</div>

@code {
    /// <summary>The permissions to offer.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PermissionInfo> Permissions { get; set; } = [];

    /// <summary>The permissions picked, which the picker changes as each is picked or put back.</summary>
    [Parameter, EditorRequired]
    public HashSet<string> Picked { get; set; } = [];

    private void Pick(string permission, ChangeEventArgs change)
    {
        if (change.Value is true)
        {
            Picked.Add(permission);
        }
        else
        {
            Picked.Remove(permission);
        }
    }
}
