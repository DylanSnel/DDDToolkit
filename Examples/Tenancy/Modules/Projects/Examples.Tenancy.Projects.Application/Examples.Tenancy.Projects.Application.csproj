<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Every project of the sample's modules declares [assembly: Module], so the boundary analyzer is live and these prove something. -->
    <WarningsAsErrors>$(WarningsAsErrors);DDD00022;DDD00023</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Projects' use cases: a command or a query for each, with its own handler; who may see and act on which
    project, with the check every request passes first; and the gate other modules ask. It declares the two ports
    it needs, IProjectStore for what its commands change and IProjectReads for what its queries and checks read,
    and the infrastructure project implements them, so this project references neither Entity Framework nor
    ASP.NET Core. The Tenancy package brings the questions it asks, the executor they run through, and the
    catalogue its keys go into; the Membership package, through the domain project, brings the questions about
    a project's crew, the requirement a request on a project declares, and the admission of a seat or a role to
    a crew. None of them knows the storage. Of the Tenants module it knows what that module publishes, through
    the domain project: the ids.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Examples.Tenancy.Projects.Domain\Examples.Tenancy.Projects.Domain.csproj" />
    <!-- What every module's paged query checks before it reads: that its page is asked for from one end, in a size of the list's own. -->
    <ProjectReference Include="..\..\..\Shared\Examples.Tenancy.Shared.Application\Examples.Tenancy.Shared.Application.csproj" />
    <ProjectReference Include="..\..\..\..\..\Source\DDDToolkit.Supporting.Tenancy\DDDToolkit.Supporting.Tenancy.csproj" />
    <!-- The module adds the texts of its refusals, English and Dutch, to the toolkit's localizer. No ASP.NET Core comes with it. -->
    <ProjectReference Include="..\..\..\..\..\Source\DDDToolkit.Localization\DDDToolkit.Localization.csproj" />
  </ItemGroup>

  <!--
    The request and handler interfaces and the pipeline, and nothing that runs them: the mediator itself is
    generated into the host, which is the one project that references Mediator.SourceGenerator.
  -->
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

  <!--
    What a paged query takes and answers: PagingArguments and Page<T>. The package has no dependencies and knows
    neither GraphQL nor a database: the infrastructure project pages, and the API project turns a page into a
    connection or into a REST answer.
  -->
  <ItemGroup>
    <PackageReference Include="GreenDonut.Data.Primitives" />
  </ItemGroup>

  <!--
    The generators. A NuGet consumer gets them through the packages above; inside this repository they are wired by
    hand. Tenancy's holds the list of keys this module marks with [TenancyPermissions] to what the project that
    composes the modules can read, and writes nothing here: a module composes no other module's keys.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Source\DDDToolkit.Analyzers\DDDToolkit.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\..\Source\DDDToolkit.Supporting.Tenancy.Analyzers\DDDToolkit.Supporting.Tenancy.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
