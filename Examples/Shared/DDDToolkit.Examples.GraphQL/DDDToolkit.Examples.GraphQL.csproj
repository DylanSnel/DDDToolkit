<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The Fusion gateway of a modular monolith: it composes the source schemas the modules registered into
    one schema, in the process. It knows no module. HotChocolate.Subscriptions.InMemory is here for the
    hosts, which choose it as the transport of the subscriptions the modules declare.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.Subscriptions.InMemory" />
    <PackageReference Include="HotChocolate.Fusion.AspNetCore" />
    <PackageReference Include="HotChocolate.Fusion.Connectors.InMemory" />
  </ItemGroup>

</Project>
