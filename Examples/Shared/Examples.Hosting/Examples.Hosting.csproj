<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Which database a module runs on is the host's choice, and how to set up each kind is the same for
    every module. This project holds that one piece of plumbing so five modules do not each carry a copy.
    It is not a module and declares no [assembly: Module]: nothing here is domain.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- IRequestExecutorBuilder, for ModuleHost.GraphQL. -->
    <PackageReference Include="HotChocolate" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not the Supabase package: a module registers its context here and says nothing of Supabase. The host checks the
      migrations of every context marked [SupabaseMigrations] with the one AddSupabaseMigrations() written into it.
    -->
    <ProjectReference Include="..\..\..\Source\DDDToolkit.EntityFramework\DDDToolkit.EntityFramework.csproj" />
  </ItemGroup>

</Project>
