<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>DDDToolkit.Examples.Host</RootNamespace>
    <!--
      No <DDD_Module> and no [assembly: Module]. The host is the composition root, not a module: it is
      allowed to see both modules, and the boundary analyzer stays silent about assemblies that never
      claimed to be modules.
    -->
  </PropertyGroup>

  <!--
    The Supabase export, as part of the build. Every build writes the files for any migration that has
    none, from every [SupabaseMigrations] factory this host references, so they are ready to commit;
    Supabase branching reads them from the repository. In CI the build only compares, and fails when
    somebody added a migration and did not commit its file.
  -->
  <PropertyGroup>
    <SupabaseMigrationsExport>Write</SupabaseMigrationsExport>
    <SupabaseMigrationsExport Condition="'$(ContinuousIntegrationBuild)' == 'true'">Check</SupabaseMigrationsExport>
  </PropertyGroup>

  <ItemGroup>
    <!-- For dotnet ef migrations add, run with this project as the startup project. Design time only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Mediator writes its implementation, its handler registrations and AddMediator into the assembly
      the generator runs in, so the generator goes in the composition root and nowhere else. Handlers in
      the module projects are still discovered, because those projects are referenced from here.
    -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ordering\DDDToolkit.Examples.Ordering\DDDToolkit.Examples.Ordering.csproj" />
    <ProjectReference Include="..\Shipping\DDDToolkit.Examples.Shipping\DDDToolkit.Examples.Shipping.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Mediator\DDDToolkit.Mediator.csproj" />
    <!-- The start-up check, EnsureSupabaseMigrationsAppliedAsync, in Program.cs. -->
    <ProjectReference Include="..\..\..\Source\DDDToolkit.EntityFramework.Supabase\DDDToolkit.EntityFramework.Supabase.csproj" />
  </ItemGroup>

  <!--
    What the DDDToolkit.EntityFramework.Supabase package brings a consumer by itself, the generator and
    the build step, spelled out because this repository references the package as a project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Source\DDDToolkit.EntityFramework.Supabase.Analyzers\DDDToolkit.EntityFramework.Supabase.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\..\Source\DDDToolkit.EntityFramework.Supabase\buildTransitive\DDDToolkit.EntityFramework.Supabase.targets" />

</Project>
