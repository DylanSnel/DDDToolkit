<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>dddtoolkit-examples-pgmq-apphost</UserSecretsId>
    <!-- ASPIRE010 asks for the Aspire CLI bundle, which only the CLI's own features need. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.Fusion.Aspire" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Examples.Webshop.Pgmq.Storefront\Examples.Webshop.Pgmq.Storefront.csproj" />
    <ProjectReference Include="..\Examples.Webshop.Pgmq.Payments\Examples.Webshop.Pgmq.Payments.csproj" />
    <ProjectReference Include="..\Examples.Webshop.Pgmq.Fulfilment\Examples.Webshop.Pgmq.Fulfilment.csproj" />
    <ProjectReference Include="..\Examples.Webshop.Pgmq.Gateway\Examples.Webshop.Pgmq.Gateway.csproj" />
  </ItemGroup>

</Project>
