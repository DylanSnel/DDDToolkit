<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Inventory and Shipping, and no other module: this service cannot call into a module it does not run, because it does
    not reference it. What it knows of the others is their contracts, through the modules it runs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Inventory\Examples.Webshop.Inventory\Examples.Webshop.Inventory.csproj" />
    <ProjectReference Include="..\..\Modules\Shipping\Examples.Webshop.Shipping\Examples.Webshop.Shipping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Examples.ServiceDefaults\Examples.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Source\DDDToolkit.Messaging.Postgres\DDDToolkit.Messaging.Postgres.csproj" />
  </ItemGroup>

</Project>
